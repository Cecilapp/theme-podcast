{#- Base layout of the demo: Cecil's default layout (Pico CSS) -#}
<!DOCTYPE html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{- include('partials/metatags.html.twig', {page: page, site: site}, with_context=false) ~}}
    <meta name="color-scheme" content="light dark">
    <style>{% apply minify_css ~%}
      {{- include('partials/pico.css.twig') ~}}
      @media (min-width: 1024px) {
        body > header,
        body > main,
        body > footer {
          max-width: 768px;
        }
      }
      body > header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--pico-spacing);
      }
      body > header hgroup {
        margin: 0;
      }
      .site-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--pico-h1-color);
        text-decoration: none;
      }
      #theme-toggle {
        --pico-background-color: transparent;
        --pico-border-color: transparent;
        --pico-color: var(--pico-muted-color);
        margin: 0;
        padding: .25rem;
        border: none;
        box-shadow: none;
      }
      .episode-cover {
        float: right;
        width: 120px;
        margin: 0 0 1rem 1rem;
        border-radius: var(--pico-border-radius);
      }
      #audioplayer {
        width: 100%;
        margin-bottom: .5rem;
      }
      .audioplayer-links {
        display: flex;
        gap: var(--pico-spacing);
        margin-bottom: var(--pico-spacing);
        font-size: .875rem;
      }
    {% endapply %}</style>
  </head>
  <body>
    <header>
      <hgroup>
        <a class="site-title" href="{{ url(site.home) }}">{{ site.title }}</a>
        <p>{{ site.baseline }}</p>
      </hgroup>
      {{- include('partials/theme-selector.html.twig', {}, with_context=false) ~}}
      {{- include('partials/navigation.html.twig', {menu: 'main'}, with_context=false) ~}}
    </header>
    <main>
      {%- block content ~%}
      {{- page.content ~}}
      {%- endblock content ~%}
    </main>
    <footer>
      {%- set powered_by -%}
      <a href="{{ cecil.url }}">Cecil</a>
      {%- endset ~%}
      <small>
        {%- if page.translations|default([])|length >= 1 %}{{ include('partials/languages.html.twig') }} · {% endif -%}
        {% trans %}Powered by %powered_by%{% endtrans %}
      </small>
    </footer>
  </body>
</html>