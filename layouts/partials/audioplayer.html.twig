{#- audio player ~#}
{%- set file = asset(page.episode.file) ~%}
{%- set links = site.podcast.player.links ?? {} ~%}
<audio controls preload="metadata" src="{{ file|url }}" id="audioplayer"></audio>
{#- links ~#}
{%- if links.download|default(false) or links.open|default(false) ~%}
<div class="audioplayer-links">
  {%- if links.download|default(false) ~%}
  <div class="audioplayer-link-download">
    <a href="{{ file|url }}" download>{% trans %}Download file{% endtrans %}</a>
  </div>
  {%- endif ~%}
  {%- if links.open|default(false) ~%}
  <div class="audioplayer-link-open">
    <a href="{{ file|url }}" target="_blank" rel="noopener">{% trans %}Play in new window{% endtrans %}</a>
  </div>
  {%- endif ~%}
</div>
{%- endif ~%}
{#- CSS ~#}
<style>
  #audioplayer {
    border-radius: 30px;
  }
</style>
{#- JS super powers ~#}
<script>{%- apply minify_js ~%}
  // handle audio script
  window.addEventListener('DOMContentLoaded', () => {
    const audioplayer = document.getElementById('audioplayer');
    if (!audioplayer) return;
    const storageKey = '{{ file|e('js') }}';
    const pageTitle = '{{ page.title|e('js') }}';
    const storage = {
      get: () => { try { return localStorage.getItem(storageKey); } catch (e) { return null; } },
      set: (value) => { try { localStorage.setItem(storageKey, value); } catch (e) {} }
    };
    // loading
    audioplayer.addEventListener('loadedmetadata', () => {
      // resume position
      const startTime = storage.get();
      if (startTime !== null) {
        audioplayer.currentTime = startTime == 'ended' ? audioplayer.duration : parseFloat(startTime) || 0;
      }
      // autoplay
      if (window.location.hash == '#autoplay') {
        audioplayer.play().catch(() => {});
      }
    });
    // playing
    audioplayer.addEventListener('timeupdate', () => {
      // save position
      if (!audioplayer.ended) {
        storage.set(audioplayer.currentTime);
      }
      // update page's title
      document.title = pageTitle + ' (' + formatTime(audioplayer.currentTime) + ')';
    });
    // ended
    audioplayer.addEventListener('ended', () => {
      storage.set('ended');
    });
    // media session
    if ('mediaSession' in navigator) {
      // media meta data
      {%- set image = asset(page.episode.image ?? site.podcast.image ?? 'cover.png') ~%}
      navigator.mediaSession.metadata = new MediaMetadata({
        title: pageTitle,
        artist: '{{ (page.episode.author ?? site.podcast.author ?? site.title)|e('js') }}',
        artwork: [
          { src: '{{ image|url|e('js') }}', sizes: '{{ image.width }}x{{ image.height }}', type: '{{ image.subtype }}' },
        ]
      });
      // display controls
      const defaultSkipTime = 10;
      const actionHandlers = {
        // backward (10s)
        seekbackward: (details) => {
          audioplayer.currentTime = Math.max(audioplayer.currentTime - (details.seekOffset || defaultSkipTime), 0);
        },
        // forward (10s)
        seekforward: (details) => {
          audioplayer.currentTime = Math.min(audioplayer.currentTime + (details.seekOffset || defaultSkipTime), audioplayer.duration);
        },
        {%- if page.prev is defined and page.prev ~%}
        // previous episode
        previoustrack: () => {
          window.location = '{{ url(page.prev)|e('js') }}#autoplay';
        },
        {%- endif ~%}
        {%- if page.next is defined and page.next ~%}
        // next episode
        nexttrack: () => {
          window.location = '{{ url(page.next)|e('js') }}#autoplay';
        },
        {%- endif ~%}
      };
      for (const [action, handler] of Object.entries(actionHandlers)) {
        try {
          navigator.mediaSession.setActionHandler(action, handler);
        } catch (error) {
          console.log(`The Media Session action "${action}" is not supported yet.`);
        }
      }
    }
    // format time
    function formatTime(time) {
      const m = Math.floor(time / 60).toString().padStart(2, '0'),
            s = Math.floor(time % 60).toString().padStart(2, '0');
      return m + ':' + s;
    }
  });
{% endapply ~%}</script>